# TypeSafe AI — required. Get a key from the TypeSafe console.
TYPESAFE_API_KEY=

# Pinned versioned model id (aliases: jev-latest, jev-preview). Responses log the
# resolved model either way.
JEV_MODEL=jev-1.13.0

# Hard budget stop: classification pauses once cumulative cost exceeds this (USD).
MAX_COST_USD=2.00

# Instagram URL mode (optional, read-only). Leave empty to disable — paste/upload
# still works. A long-lived token pasted here is enough; no OAuth flow. URL mode
# resolves the pasted post URL against the connected account's own media.
IG_ACCESS_TOKEN=
# Instagram-login tokens (default): graph.instagram.com + "me".
# Facebook-login tokens: set IG_GRAPH_HOST=https://graph.facebook.com/v21.0 and
# IG_USER_ID=<numeric ig-user-id>.
IG_GRAPH_HOST=https://graph.instagram.com/v21.0
IG_USER_ID=me
