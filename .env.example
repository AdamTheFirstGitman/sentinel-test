# TypeSafe AI — required. Get a key from the TypeSafe console.
TYPESAFE_API_KEY=

# Optional: pin a versioned model id from the console (default: jev-latest).
JEV_MODEL=jev-latest

# Hard budget stop: classification pauses once cumulative cost exceeds this (USD).
MAX_COST_USD=2.00

# Instagram Graph API mode (optional, read-only). Leave empty to disable.
# Long-lived token pasted here is enough; no OAuth flow is implemented.
IG_ACCESS_TOKEN=
IG_MEDIA_ID=
